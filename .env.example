GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
INPUT_COST_PER_1M_USD=0.30
OUTPUT_COST_PER_1M_USD=2.50
# set on the day
USD_TO_GBP=0.80
SESSION_BUDGET_CAP_GBP=0.05
GLOBAL_BUDGET_CAP_GBP=0.50
# docker | cloudrun
SANDBOX_PROVIDER=docker
SANDBOX_DOCKER_IMAGE=agentguard-sandbox:latest
CLOUDRUN_SANDBOX_URL=
SQLITE_DB_PATH=data/guard_state.db
CLASSIFIER_TIMEOUT_SEC=5
# tokens used to reserve cost before a model call
BUDGET_RESERVE_INPUT_TOKENS=610
BUDGET_RESERVE_OUTPUT_TOKENS=512
# Optional per-role model settings. Unset or empty: the classifier uses the values
# above, and the agent uses the classifier's. A role with a different URL needs its
# own key; one with a different model or URL needs both of its own rates.
# URLs must be https, or http to a loopback host.
# CLASSIFIER_PROVIDER=gemini
# CLASSIFIER_BASE_URL=
# CLASSIFIER_MODEL=
# CLASSIFIER_API_KEY=
# CLASSIFIER_INPUT_COST_PER_1M_USD=
# CLASSIFIER_OUTPUT_COST_PER_1M_USD=
# CLASSIFIER_MAX_OUTPUT_TOKENS=
# AGENT_PROVIDER=
# AGENT_BASE_URL=
# AGENT_MODEL=
# AGENT_API_KEY=
# AGENT_INPUT_COST_PER_1M_USD=
# AGENT_OUTPUT_COST_PER_1M_USD=
# AGENT_TIMEOUT_SEC=
# AGENT_MAX_OUTPUT_TOKENS=
# measured 2026-11-27: about 0.0002 per call, so the loop trips at step 4
PRESET3_SESSION_CAP_GBP=0.0017
PRESET3_MAX_STEPS=6
# Ledger retention in days (0 = disabled, retain indefinitely)
LEDGER_RETENTION_DAYS=0
# Default per-client budget cap in GBP
CLIENT_BUDGET_CAP_GBP=0.10
